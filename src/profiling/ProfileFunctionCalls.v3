// Used during both `profileFunctionCalls` and `profileFuncObjectCalls`
class ProfiledFuncData #unboxed {
	def label: string;
	var calls: int;
	var inclusiveTime: long; // ticks
	var exclusiveTime: long; // ticks

	new(label, calls, inclusiveTime, exclusiveTime) {}
}

// This object is stored in the `Profiling.callDataFrames` array stack
// The relevant call frame object for any `ProfileCallFrameData` object will always be at the same depth in the VM's call frames array stack.
class ProfileCallFrameData #unboxed {
	def uid: int;
	def startTime: long; // ticks
	var totalCalleeTime: long = 0; // ticks
	new(uid, startTime) {}
}

component ProfileFunctionCalls{

    private def profile(dict: HashMap<int, ProfiledFuncData>, key: int, name: string, inclusiveTime: long, exclusiveTime: long){
        if (dict.has(key)){
            def data: ProfiledFuncData = dict[key];
            data.calls += 1; // increment calls
            data.inclusiveTime += inclusiveTime;
            data.exclusiveTime += exclusiveTime;
        } else {
            dict[key] = ProfiledFuncData.new(name, 1, inclusiveTime, exclusiveTime);
        }
    }

    def profileFunctionCall(metadata: FunctionProfileMetadata, inclusiveTime: long, exclusiveTime: long){
        profile(Profiling.funcCallCounts, metadata.identifier, metadata.label, inclusiveTime, exclusiveTime);
    }

    def profileFunctionObjectCall(uid: int, label: string, inclusiveTime: long, exclusiveTime: long){
        profile(Profiling.funcObjectCallCounts, uid, label, inclusiveTime, exclusiveTime);
    }

    private def printStats(dict: HashMap<int, ProfiledFuncData>){
        for (list = Maps.keyList(dict); list != null; list = list.tail) {
            def key: int = list.head;
            def data: ProfiledFuncData = dict[key];

            System.puts(Strings.format3("%d, %s, %d, ", key, data.label, data.calls));
            System.puts(Strings.format2("%s, %s\n", ProfilingHelpers.longToString(data.inclusiveTime), ProfilingHelpers.longToString(data.exclusiveTime)));
        }
    }

    def printFuncCallsStats(){
        System.puts("Function identifier, Function label, calls, inclusive execution time(ticks), exclusive execution time(ticks)\n");
        printStats(Profiling.funcCallCounts);
    }

    def printFuncObjectCallsStats(){
        System.puts("Function object uid, Function label, calls, inclusive execution time(ticks), exclusive execution time(ticks)\n");
        printStats(Profiling.funcObjectCallCounts);
    }
}